# Copy to .env, or run scripts/init-env.sh to create .env with random local secrets.
# docker compose reads .env; variables exported in the shell override it.

# Postgres password used by Document Engine.
PG_PASSWORD=
# Document Engine API token (also used by the backend) and secret key base (64+ characters).
DE_API_TOKEN=
DE_SECRET_KEY_BASE=
# Document Engine license. Both empty = evaluation mode (watermark).
# ACTIVATION_KEY needs internet access; LICENSE_KEY is an offline key.
DE_ACTIVATION_KEY=
DE_LICENSE_KEY=
# Default owner password set on the PDF (a request can send its own).
OWNER_PASSWORD=
# SoftHSM token and key labels.
PKCS11_TOKEN_LABEL=poc-signing-token
PKCS11_KEY_LABEL=poc-approval-signer
# SoftHSM user PIN and security officer PIN.
PKCS11_PIN=
PKCS11_SO_PIN=
# .p12 used for signing inside the signing service. Empty = HSM (PKCS#11) mode.
SIGNING_P12_PATH=/p12/poc-signer.p12
# Password of the .p12 (also used when the test .p12 is created).
SIGNING_P12_PASSWORD=
